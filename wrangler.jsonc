{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "beneficiaries",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "beneficiaries" }
  ],
  // قاعدة البيانات (SQLite على Cloudflare)
  "d1_databases": [
    { "binding": "DB", "database_name": "beneficiaries-db", "database_id": "243aa4d5-eeb5-4abe-a880-b95af87a259c" }
  ],
  // الصور: المفتاح <Entity>/<file>.webp
  "kv_namespaces": [
    { "binding": "PHOTOS", "id": "bfe1fc75ad884bd4aef65d5a7012a288" }
  ],
  "vars": { "COOKIE_SECURE": "true" },
  "observability": { "enabled": true }
}
