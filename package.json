{
  "name": "beneficiary-viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build-data": "node scripts/build-data.js",
    "test": "node --no-warnings --test \"tests/*.test.mjs\"",
    "db:import": "node --no-warnings scripts/db-import.mjs",
    "db:backup": "node --no-warnings scripts/db-backup.mjs",
    "user:add": "node --no-warnings scripts/user-add.mjs",
    "cf:build": "cross-env CF_BUILD=1 opennextjs-cloudflare build",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@tailwindcss/postcss": "^4",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=24"
  }
}
